---
interface Props {
    className?: string; 
}

const { className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="40"
  height="40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  viewBox="0 0 24 24"
  class={className}
>
  <line x1="18" y1="20" x2="18" y2="10" />
  <line x1="12" y1="20" x2="12" y2="4" />
  <line x1="6" y1="20" x2="6" y2="14" />
</svg>