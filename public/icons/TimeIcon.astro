---
interface Props {
    className?: string; 
}

const { className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="40"
  height="40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  viewBox="0 0 24 24"
  class={className}
>
  <circle cx="12" cy="12" r="10" />
  <polyline points="12 6 12 12 16 14" />
</svg>